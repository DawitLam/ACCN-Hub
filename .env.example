# Environment Variables
NODE_ENV=development
PORT=3000

# Database
MONGODB_URI=mongodb://localhost:27017/accn-hub
# For MongoDB Atlas, use:
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/accn-hub

# JWT Authentication
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRE=7d

# OpenAI API (for AI lesson generation)
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4

# YouTube API (for video recommendations)
YOUTUBE_API_KEY=your-youtube-api-key-here

# Email Configuration (for notifications and certificates)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-email-password

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# File Upload
MAX_FILE_SIZE=10485760
UPLOAD_PATH=./uploads

# Certificate Generation
CERTIFICATE_TEMPLATE_PATH=./frontend/assets/templates/certificate-template.pdf
CERTIFICATE_OUTPUT_PATH=./certificates

# Session
SESSION_SECRET=your-session-secret-key-change-this
