# ===================================
# ACCN Hub Environment Configuration
# ===================================

# ===================================
# DEPLOYMENT MODE
# ===================================

# Set NODE_ENV to 'production' when deploying to hosting platforms
NODE_ENV=development

# Server Port (default: 3000)
PORT=3000

# ===================================
# DATABASE CONFIGURATION
# ===================================

# --- Option 1: Local Development (Curriculum Viewer Only) ---
# For viewing curriculum without LMS features (no user accounts, progress tracking)
# Uncomment the line below to run without MongoDB:
MONGODB_OPTIONAL=true

# --- Option 2: Full LMS Features (Requires MongoDB) ---
# For production deployment with user accounts, progress tracking, certificates
# Get MongoDB Atlas connection string from: https://www.mongodb.com/cloud/atlas

# Local MongoDB (for development):
# MONGODB_URI=mongodb://localhost:27017/accn-hub

# MongoDB Atlas (for production - RECOMMENDED):
# MONGODB_URI=mongodb+srv://YOUR_USERNAME:YOUR_PASSWORD@YOUR_CLUSTER.mongodb.net/accn-hub?retryWrites=true&w=majority

# ===================================
# AUTHENTICATION & SECURITY
# ===================================

# JWT Secret Key (CHANGE THIS IN PRODUCTION!)
# Generate secure key with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=REPLACE_WITH_YOUR_SECURE_RANDOM_STRING_USE_THE_COMMAND_ABOVE
JWT_EXPIRE=7d

# Session Secret (CHANGE THIS IN PRODUCTION!)
SESSION_SECRET=REPLACE_WITH_RANDOM_STRING

# ===================================
# AI & CONTENT GENERATION (Optional)
# ===================================

# OpenAI API Key (for lesson generation features - optional)
CONTENT_API_KEY=REPLACE_WITH_YOUR_API_KEY
CONTENT_MODEL=gpt-3.5-turbo

# YouTube API Key (for video recommendations - optional)
YOUTUBE_API_KEY=REPLACE_WITH_YOUR_YOUTUBE_KEY

# ===================================
# EMAIL CONFIGURATION (Optional)
# ===================================

# SMTP Email Settings (for notifications and certificates)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=REPLACE_WITH_YOUR_EMAIL
EMAIL_PASSWORD=REPLACE_WITH_YOUR_APP_PASSWORD

# ===================================
# FRONTEND & CORS
# ===================================

# Frontend URL (for CORS configuration)
# For local development:
FRONTEND_URL=http://localhost:3000

# For production (change to your actual domain):
# FRONTEND_URL=https://your-domain.com

# ===================================
# FILE UPLOADS & STORAGE
# ===================================

# Maximum file upload size in bytes (default: 10MB)
MAX_FILE_SIZE=10485760

# Upload and certificate paths
UPLOAD_PATH=./uploads
CERTIFICATE_TEMPLATE_PATH=./frontend/assets/templates/certificate-template.pdf
CERTIFICATE_OUTPUT_PATH=./certificates

# ===================================
# DEPLOYMENT PLATFORM EXAMPLES
# ===================================

# Vercel / Netlify (Static + Serverless):
# NODE_ENV=production
# MONGODB_URI=mongodb+srv://...
# FRONTEND_URL=https://your-app.vercel.app

# Railway / Render (Full Node.js):
# NODE_ENV=production
# PORT=3000  (or use $PORT from platform)
# MONGODB_URI=mongodb+srv://...

# Heroku:
# NODE_ENV=production
# PORT=$PORT
# MONGODB_URI=mongodb+srv://...
