# Environment Variables
NODE_ENV=development
PORT=3000

# Database
MONGODB_URI=mongodb://localhost:27017/accn-hub
# For MongoDB Atlas, use format:
# MONGODB_URI=mongodb+srv://YOUR_USERNAME:YOUR_PASSWORD@YOUR_CLUSTER.mongodb.net/accn-hub

# JWT Authentication
JWT_SECRET=REPLACE_WITH_YOUR_SECURE_RANDOM_STRING
JWT_EXPIRE=7d

# Content Generation API (for lesson generation feature)
CONTENT_API_KEY=REPLACE_WITH_YOUR_API_KEY
CONTENT_MODEL=default

# YouTube API (for video recommendations)
YOUTUBE_API_KEY=REPLACE_WITH_YOUR_YOUTUBE_KEY

# Email Configuration (for notifications and certificates)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=REPLACE_WITH_YOUR_EMAIL
EMAIL_PASSWORD=REPLACE_WITH_YOUR_APP_PASSWORD

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# File Upload
MAX_FILE_SIZE=10485760
UPLOAD_PATH=./uploads

# Certificate Generation
CERTIFICATE_TEMPLATE_PATH=./frontend/assets/templates/certificate-template.pdf
CERTIFICATE_OUTPUT_PATH=./certificates

# Session
SESSION_SECRET=REPLACE_WITH_RANDOM_STRING
