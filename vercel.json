{
  "version": 2,
  "builds": [
    {
      "src": "api/index.js",
      "use": "@vercel/node"
    },
    {
      "src": "frontend/**",
      "use": "@vercel/static"
    },
    {
      "src": "AI_CERTIFICATION_CURRICULUM.md",
      "use": "@vercel/static"
    },
    {
      "src": "curriculum/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "api/index.js"
    },
    {
      "src": "/AI_CERTIFICATION_CURRICULUM.md",
      "dest": "AI_CERTIFICATION_CURRICULUM.md"
    },
    {
      "src": "/curriculum/(.*)",
      "dest": "curriculum/$1"
    },
    {
      "src": "/frontend/(.*)",
      "dest": "frontend/$1"
    },
    {
      "src": "/",
      "dest": "frontend/home.html"
    },
    {
      "src": "/(.*)",
      "dest": "frontend/$1"
    }
  ],
  "env": {
    "NODE_ENV": "production",
    "MONGODB_OPTIONAL": "true",
    "VERCEL": "1"
  }
}
